/* PROC TABULATE */

data sales;
  input Region $ Product $ Units Revenue;
  datalines;
East Pen 10 100
East Book 5 150
East Pen 8 80
West Pen 12 120
West Book 7 210
West Book 4 120
North Pen 6 60
North Book 9 270
;
run;

/* COUNT OF ROWS PER REGION */

PROC TABULATE DATA = SALES;
CLASS REGION;
TABLE REGION;
RUN;

/* TOTAL REVENUE PER REGION */

PROC TABULATE DATA = SALES;
CLASS REGION;
VAR REVENUE;
TABLE REGION, REVENUE*SUM;
RUN;

/* IF YOU WRITE REVENUE*MEAN */

PROC TABULATE DATA = SALES;
CLASS REGION;
VAR REVENUE;
TABLE REGION, REVENUE*MEAN;
RUN;

/* REGION(ROWS) BY PRODUCT(COLUMNS) */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE;
TABLE REGION, PRODUCT*REVENUE*SUM;
RUN;

/* ADD TOTALS & FORMAT */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE REGION ALL, PRODUCT*REVENUE*SUM ALL*REVENUE*SUM*F=COMMA8.;
RUN;

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE REGION ALL, PRODUCT*UNITS*SUM ALL*UNITS*SUM*F=COMMA8.;
RUN;

/* TO FORMAT ON ALL: */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE REGION ALL, PRODUCT*UNITS*SUM*F=COMMA8. ALL*UNITS*SUM*F=COMMA8.;
RUN;

/* AVERAGE UNITS PER PRODUCT: */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE REGION ALL, PRODUCT*UNITS*MEAN*F=COMMA8. ALL*UNITS*MEAN*F=COMMA8.;
RUN;

/* FOR AVERAGE USE FORMAT WITH DECIMALS: */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE REGION ALL, PRODUCT*UNITS*MEAN*F=COMMA8.1 ALL*UNITS*MEAN*F=COMMA8.1;
RUN;

/* PRACTICE QUESTIONS */

/* 1. Show total Units and total Revenue side by side for each Region.  */

PROC TABULATE DATA = SALES;
CLASS REGION;
VAR REVENUE UNITS;
TABLE REGION ALL, UNITS*SUM*F=COMMA8. REVENUE*SUM*F=COMMA8.;
RUN;

/* 2. Show Product as rows and Region as columns. */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
TABLE PRODUCT, REGION;
RUN;

/* 3. Add all totals to your Task 2 table. */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
TABLE PRODUCT ALL, REGION;
RUN;

/* 4. Show Product as rows and Region as columns, with Units*sum. */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE PRODUCT, REGION UNITS*SUM*F=C0MMA8.;
RUN;

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE PRODUCT, REGION*UNITS*SUM*F=C0MMA8.;
RUN;

/* 5. Add all totals to that table. */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE PRODUCT ALL, REGION UNITS*SUM*F=C0MMA8.;
RUN;

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR UNITS;
TABLE PRODUCT ALL, REGION*UNITS*SUM*F=C0MMA8. ALL*UNITS*SUM*F=COMMA8.;
RUN;

/* ADD REVENUE NEXT TO UNITS, INSIDE EACH REGION */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE PRODUCT ALL, REGION*(UNITS REVENUE)*SUM*F=COMMA8.;
RUN;

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE PRODUCT ALL, REGION*(UNITS REVENUE)*SUM*F=COMMA8. ALL*(UNITS REVENUE)*SUM*F=COMMA8.;
RUN;

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE PRODUCT ALL, REGION*UNITS*SUM*F=COMMA8. REGION*REVENUE*MEAN*F=COMMA8.;
RUN;

/* COMBINE EVERYTHING IN ONE TABLE: */

PROC TABULATE DATA = SALES;
CLASS REGION PRODUCT;
VAR REVENUE UNITS;
TABLE PRODUCT ALL, REGION*(UNITS*SUM REVENUE*MEAN)*F=COMMA8.;
RUN;



















































































