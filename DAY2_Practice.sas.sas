/* OBS, FIRSTOBS*/

PROC PRINT DATA  = WORK.PAT(OBS = 3);
RUN;

DATA WORK.PAT;
INPUT ID $ SEX $ DOB :DATE9. VISIT :DATE9. WT HT NAME $20.;
FORMAT DOB VISIT DATE9.;
CARDS;
101 M 12MAR1985 05JAN2026 78 172 JOHN SMITH
102 F 25JUL1990 06JAN2026 62 160 MARY JONES
103 M 03DEC1978 10JAN2026 91 180 RAJ KUMAR
104 F 14FEB2001 12JAN2026 55 158 ANITHA RAO
105 M 30JUN1995 15JAN2026 84 175 TOM LEE
RUN;

PROC PRINT DATA = WORK.PAT(OBS = 3);
RUN;

PROC PRINT DATA = WORK.PAT(FIRSTOBS = 2 OBS = 4);
RUN;

DATA WORK.PAT2;
SET WORK.PAT(OBS = 2);
RUN;

PROC PRINT DATA = WORK.PAT(OBS = 2);
RUN;

PROC PRINT DATA = WORK.PAT (FIRSTOBS = 4);
RUN;

PROC PRINT DATA = WORK.PAT (FIRSTOBS = 2 OBS = 3);
RUN;

PROC PRINT DATA = WORK.PAT (FIRSTOBS = 4 OBS = 2);
RUN;

/* NOOBS */

PROC PRINT DATA = WORK.PAT NOOBS LABEL;
VAR ID SEX WT;
LABEL WT = 'WEIGHT (KG)';
RUN;

PROC PRINT DATA = WORK.PAT (OBS = 3) NOOBS;
RUN;

PROC PRINT DATA  = WORK.PAT NOOBS;
RUN;

/* TEST-1 */
PROC PRINT DATA = WORK.PAT (FIRSTOBS = 2 OBS = 3) NOOBS;
RUN;

/* TEST-2 */
PROC PRINT DATA = WORK.PAT NOOBS LABEL;
VAR ID WT ;
WHERE SEX = 'M';
LABEL WT = 'WEIGHT';
RUN;

/* TEST-3 */

DATA WORK.PAT_S;
SET WORK.PAT;
RUN;

PROC SORT DATA = WORK.PAT_S;
BY SEX DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S (FIRSTOBS = 1 OBS = 2) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT_S;
BY SEX ASCENDING;
BY DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S (FIRSTOBS = 1 OBS = 2) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT_S;
BY SEX DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S (FIRSTOBS = 1 OBS = 2) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT OUT = WORK.PAT_S;
BY SEX DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S (FIRSTOBS = 1 OBS = 2) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT OUT = WORK.PAT_S ;
BY SEX DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S(FIRSTOBS = 1 OBS = 2) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT OUT = WORK.PAT_S ;
BY SEX DESCENDING WT;
RUN;

PROC PRINT DATA = WORK.PAT_S(OBS = 2) NOOBS;
RUN;

/* TEST-4 */


PROC SORT DATA = WORK.PAT OUT = WORK.OLDEST;
BY DOB ;
RUN;

PROC PRINT DATA = WORK.OLDEST (OBS = 1) NOOBS;
RUN;

PROC SORT DATA = WORK.PAT OUT = WORK.OLDEST (OBS = 1);
BY DOB ;
RUN;



















